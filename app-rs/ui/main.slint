// AURALIS STUDIO — PitchForge product UI (Rust/Slint)
// Palette: design-system/auralis-studio/MASTER.md

import {
    VerticalBox,
    HorizontalBox,
    Slider,
    ComboBox,
    Button,
    LineEdit,
    ScrollView,
} from "std-widgets.slint";

global Palette {
    in property <color> background: #090909;
    in property <color> surface: #171717;
    in property <color> outline: #292929;
    in property <color> text: #F4F4F4;
    in property <color> textMuted: #9B9B9B;
    in property <color> primary: #FFB000;
    in property <color> cyan: #00CFE8;
    in property <color> accent: #00D6A0;
    in property <color> destructive: #FF416B;
    in property <color> onAccent: #07100D;
}

// ---------------------------------------------------------------------------
// Styled primitives
// ---------------------------------------------------------------------------

component StatusBadge {
    in property <string> status-text;
    in property <color> badge-color;
    Rectangle {
        background: #101214;
        border-width: 1px;
        border-color: badge-color;
        border-radius: 4px;
        height: 28px;
        Text {
            text: status-text;
            color: badge-color;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}

component MeterBar {
    // A vertical meter bar with a peak fill and an RMS fill.
    in property <float> peak;
    in property <float> rms;
    property <float> fill: max(0.0, min(1.0, peak));

    Rectangle {
        width: 22px;
        height: 142px;
        background: #090A0B;
        border-width: 1px;
        border-color: Palette.outline;
        border-radius: 4px;
        Rectangle {
            width: 100%;
            height: 142px * fill;
            background: peak > 0.98 ? Palette.destructive : Palette.accent;
            border-radius: 3px;
        }
        Rectangle {
            width: 8px;
            height: 110px * max(0.0, min(1.0, rms));
            background: Palette.cyan;
            border-radius: 2px;
            y: 16px;
        }
    }
}

component WaveformView {
    in property <[float]> samples;
    Rectangle {
        width: 100%; height: 86px;
        background: #090A0B;
        border-width: 1px; border-color: Palette.outline; border-radius: 5px;
        Rectangle { x: 0; y: parent.height / 2; width: parent.width; height: 1px; background: #283038; }
        for sample[i] in samples: Rectangle {
            x: i * (parent.width / samples.length);
            width: max(1px, parent.width / samples.length - 1px);
            height: max(2px, min(1.0, abs(sample)) * (parent.height - 10px));
            y: (parent.height - self.height) / 2;
            background: Palette.cyan;
            border-radius: 1px;
        }
    }
}

// ---------------------------------------------------------------------------
// Devices panel
// ---------------------------------------------------------------------------

component DevicesPanel {
    in property <[string]> input-names;
    in property <[string]> output-names;
    in-out property <int> selected-input;
    in-out property <int> selected-output;
    in property <string> input-status;
    in property <string> output-status;

    VerticalBox {
        Text {
            text: "DEVICES";
            color: Palette.textMuted;
            font-size: 15px;
        }
        Text {
            text: "INPUT";
            color: Palette.textMuted;
            font-size: 15px;
        }
        ComboBox {
            model: input-names;
            current-index: selected-input;
        }
        Text {
            text: input-status;
            color: Palette.textMuted;
            font-size: 15px;
        }
        Text {
            text: "OUTPUT";
            color: Palette.textMuted;
            font-size: 15px;
        }
        ComboBox {
            model: output-names;
            current-index: selected-output;
        }
        Text {
            text: output-status;
            color: Palette.textMuted;
            font-size: 15px;
        }
    }
}

// ---------------------------------------------------------------------------
// Mixer panel
// ---------------------------------------------------------------------------

component MixerPanel {
    in property <float> in-peak-l;
    in property <float> in-peak-r;
    in property <float> in-rms-l;
    in property <float> in-rms-r;
    in property <float> out-peak-l;
    in property <float> out-peak-r;
    in property <float> out-rms-l;
    in property <float> out-rms-r;
    in property <bool> clipping;
    in property <string> latency-text;
    in property <string> status-text;

    VerticalBox {
        Text {
            text: "MIXER";
            color: Palette.textMuted;
            font-size: 15px;
        }
        HorizontalBox {
            spacing: 16px;
            VerticalBox {
                Text {
                    text: "INPUT";
                    color: Palette.textMuted;
                    font-size: 15px;
                }
                MeterBar {
                    peak: in-peak-l;
                    rms: in-rms-l;
                }
                MeterBar {
                    peak: in-peak-r;
                    rms: in-rms-r;
                }
            }
            VerticalBox {
                Text {
                    text: "OUTPUT";
                    color: Palette.textMuted;
                    font-size: 15px;
                }
                MeterBar {
                    peak: out-peak-l;
                    rms: out-rms-l;
                }
                MeterBar {
                    peak: out-peak-r;
                    rms: out-rms-r;
                }
            }
        }
        Text {
            text: latency-text;
            color: Palette.textMuted;
            font-size: 15px;
        }
        Text {
            text: status-text;
            color: Palette.textMuted;
            font-size: 15px;
        }
    }
}

// ---------------------------------------------------------------------------
// Effect slot card
// ---------------------------------------------------------------------------

component EffectSlot {
    in property <string> name;
    in property <bool> present;
    in property <bool> enabled;
    in property <string> wet-text;
    in property <string> param0-text;
    in property <string> param1-text;
    in property <string> param2-text;
    in property <string> param3-text;
    in property <string> param4-text;
    in property <string> param5-text;
    callback toggle;

    Rectangle {
      width: 100%; height: 76px;
      background: Palette.surface;
      border-width: 1px;
      border-color: Palette.outline;
      border-radius: 8px;
      HorizontalBox {
        padding: 9px;
        spacing: 6px;
        VerticalBox {
            alignment: center;
            Text { text: name; color: Palette.text; font-size: 13px; font-weight: 700; }
            Text { text: present ? "WET  " + wet-text : "NOT IN CHAIN"; color: Palette.textMuted; font-size: 10px; }
        }
        Button {
            text: present ? (enabled ? "ON" : "OFF") : (name == "AUTO TUNE" ? "+ AUTO TUNE" : "+ ADD");
            clicked => { root.toggle(); }
        }
      }
    }
}

// ---------------------------------------------------------------------------
// App
// ---------------------------------------------------------------------------

export component App inherits Window {
    title: "PitchForge — Voice Studio";
    preferred-width: 1360px;
    preferred-height: 820px;
    min-width: 900px;
    min-height: 640px;
    background: Palette.background;

    // --- devices ---
    in-out property <[string]> input-device-names;
    in-out property <[string]> output-device-names;
    in-out property <int> selected-input;
    in-out property <int> selected-output;
    in-out property <string> input-device-status;
    in-out property <string> output-device-status;

    // --- engine ---
    in-out property <string> engine-warning;
    in-out property <bool> engine-started;
    in-out property <string> engine-error;
    in-out property <string> start-button-text;

    // --- mixer ---
    in-out property <float> input-gain-db;
