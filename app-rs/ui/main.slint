    in-out property <bool> rev-present;
    in-out property <bool> rev-enabled;
    in-out property <float> rev-wet;
    in-out property <string> rev-wet-text;
    in-out property <bool> rev-p0;
    in-out property <float> rev-p0v;
    in-out property <string> rev-p0t;
    in-out property <bool> rev-p1;
    in-out property <float> rev-p1v;
    in-out property <string> rev-p1t;
    in-out property <bool> rev-p2;
    in-out property <float> rev-p2v;
    in-out property <string> rev-p2t;
    in-out property <bool> rev-p3;
    in-out property <float> rev-p3v;
    in-out property <string> rev-p3t;
    in-out property <bool> rev-p4;
    in-out property <float> rev-p4v;
    in-out property <string> rev-p4t;
    in-out property <bool> rev-p5;
    in-out property <float> rev-p5v;
    in-out property <string> rev-p5t;

    in-out property <bool> delay-present;
    in-out property <bool> delay-enabled;
    in-out property <float> delay-wet;
    in-out property <string> delay-wet-text;
    in-out property <bool> delay-p0;
    in-out property <float> delay-p0v;
    in-out property <string> delay-p0t;
    in-out property <bool> delay-p1;
    in-out property <float> delay-p1v;
    in-out property <string> delay-p1t;
    in-out property <bool> delay-p2;
    in-out property <float> delay-p2v;
    in-out property <string> delay-p2t;
    in-out property <bool> delay-p3;
    in-out property <float> delay-p3v;
    in-out property <string> delay-p3t;

    in-out property <bool> lim-present;
    in-out property <bool> lim-enabled;
    in-out property <float> lim-wet;
    in-out property <string> lim-wet-text;
    in-out property <bool> lim-p0;
    in-out property <float> lim-p0v;
    in-out property <string> lim-p0t;
    in-out property <bool> lim-p1;
    in-out property <float> lim-p1v;
    in-out property <string> lim-p1t;
    in-out property <bool> lim-p2;
    in-out property <float> lim-p2v;
    in-out property <string> lim-p2t;

    // --- pitch display ---
    in-out property <bool> pitch-available;
    in-out property <float> pitch-detected-hz;
    in-out property <float> pitch-target-hz;
    in-out property <float> pitch-confidence;
    in-out property <float> pitch-shift;
    in-out property <string> pitch-detected-text;
    in-out property <string> pitch-target-text;
    in-out property <string> pitch-confidence-text;
    in-out property <string> pitch-shift-text;

    // --- presets ---
    in-out property <[string]> preset-names;
    in-out property <int> selected-preset;
    in-out property <string> preset-name;
    in-out property <string> presets-info;

    in-out property <string> chain-summary;
    in-out property <[float]> waveform;
    in-out property <bool> waveform-supported;
    in-out property <bool> test-tone;
    in-out property <bool> test-tone-supported;

    callback mute-toggle;
    callback refresh-devices;
    callback start-engine;
    callback save-preset;
    callback load-preset;
    callback ng-toggle;
    callback eq-toggle;
    callback deesser-toggle;
    callback comp-toggle;
    callback pitch-toggle;
    callback sat-toggle;
    callback rev-toggle;
    callback delay-toggle;
    callback lim-toggle;
    callback test-tone-toggle;

    ScrollView {
      width: 100%;
      height: 100%;
      VerticalBox {
        width: 100%;
        spacing: 10px;
        padding: 12px;

        // Top bar: brand, engine status and primary action.
        Rectangle {
            width: 100%; height: 58px;
            background: #151515; border-width: 1px; border-color: Palette.outline; border-radius: 7px;
            HorizontalBox {
                padding: 10px; spacing: 10px;
                Text { text: "◉  SoundCard Studio  PRO"; color: Palette.text; font-size: 17px; font-weight: 800; vertical-alignment: center; }
                Text { text: "BỘ XỬ LÝ GIỌNG HÁT · AUTO-TUNE & SOUNDCARD LIVESTREAM"; color: Palette.textMuted; font-size: 9px; vertical-alignment: center; }
                ComboBox { model: input-device-names; current-index: selected-input; }
                StatusBadge {
                    status-text: engine-started ? "● MIC MỞ" : (engine-warning != "" ? "● LỖI ENGINE" : "● SẴN SÀNG");
                    badge-color: engine-error != "" ? Palette.destructive : Palette.accent;
                }
                Button { text: test-tone ? "DỪNG THỬ ÂM" : "THỬ MẪU GIỌNG"; enabled: test-tone-supported; clicked => { root.test-tone-toggle(); } }
                Button { text: start-button-text; enabled: engine-warning == ""; clicked => { root.start-engine(); } }
                Button { text: muted ? "KIỂM ÂM: TẮT" : "KIỂM ÂM: BẬT"; clicked => { root.mute-toggle(); } }
            }
        }

        Rectangle {
            width: 100%; height: 112px;
            background: Palette.surface; border-width: 1px; border-color: Palette.outline; border-radius: 8px;
            VerticalBox {
                padding: 10px; spacing: 5px;
                HorizontalBox {
                    Text { text: "PHỔ TẦN ÂM THANH"; color: Palette.text; font-size: 11px; font-weight: 700; }
                    Text { text: !waveform-supported ? "CẬP NHẬT AUDIO ENGINE ĐỂ HIỂN THỊ DẠNG SÓNG" : (test-tone ? "440 Hz · ÂM KIỂM TRA" : "48 kHz · 24-BIT · TRỰC TIẾP"); color: test-tone ? Palette.accent : Palette.textMuted; font-size: 10px; }
                }
                WaveformView { samples: waveform; }
            }
        }

        // Device meters and signal status.
        Rectangle {
            width: 100%; height: 208px;
            background: Palette.surface; border-width: 1px; border-color: Palette.outline; border-radius: 8px;
            VerticalBox {
                padding: 14px; spacing: 10px;
                HorizontalBox {
                    Text { text: "GIÁM SÁT TÍN HIỆU  /  INPUT → OUTPUT"; color: Palette.text; font-size: 12px; font-weight: 700; }
                    Text { text: latency-text + "    " + (clipping ? "ĐANG CLIP" : "TÍN HIỆU ỔN"); color: clipping ? Palette.destructive : Palette.accent; font-size: 10px; }
                }
                HorizontalBox {
                    spacing: 28px;
                    VerticalBox {
                        Text { text: "MIC INPUT"; color: Palette.textMuted; font-size: 11px; }
                        HorizontalBox {
                            spacing: 8px;
                            MeterBar { peak: in-peak-l; rms: in-rms-l; }
                            MeterBar { peak: in-peak-r; rms: in-rms-r; }
                            VerticalBox {
                                Text { text: "LEFT"; color: Palette.textMuted; font-size: 10px; }
                                Text { text: "RIGHT"; color: Palette.textMuted; font-size: 10px; }
                                Text { text: input-device-status; color: Palette.textMuted; font-size: 10px; }
                            }
                        }
                    }
                    Rectangle { width: 1px; height: 128px; background: Palette.outline; }
                    VerticalBox {
                        Text { text: "MASTER OUTPUT"; color: Palette.textMuted; font-size: 11px; }
                        HorizontalBox {
                            spacing: 8px;
                            MeterBar { peak: out-peak-l; rms: out-rms-l; }
                            MeterBar { peak: out-peak-r; rms: out-rms-r; }
                            VerticalBox {
                                Text { text: "LEFT"; color: Palette.textMuted; font-size: 10px; }
                                Text { text: "RIGHT"; color: Palette.textMuted; font-size: 10px; }
                                Text { text: output-device-status; color: Palette.textMuted; font-size: 10px; }
                            }
                        }
                    }
                    Rectangle { width: 1px; height: 128px; background: Palette.outline; }
                    VerticalBox {
                        Text { text: "GAIN STAGING"; color: Palette.textMuted; font-size: 11px; }
                        Text { text: "INPUT  " + input-gain-text; color: Palette.text; font-size: 13px; }
                        Slider { minimum: -60; maximum: 24; value: input-gain-db; }
                        Text { text: "OUTPUT  " + output-gain-text; color: Palette.text; font-size: 13px; }
                        Slider { minimum: -60; maximum: 12; value: output-gain-db; }
                    }
                }
            }
        }

        // Preset strip.
        Rectangle {
            width: 100%; height: 54px;
            background: #151719; border-width: 1px; border-color: Palette.outline; border-radius: 8px;
            HorizontalBox {
                padding: 9px; spacing: 8px;
                Text { text: "PRESET NHANH"; color: Palette.primary; font-size: 10px; vertical-alignment: center; }
                ComboBox { model: preset-names; current-index: selected-preset; }
                LineEdit { text: preset-name; }
                Button { text: "SAVE"; clicked => { root.save-preset(); } }
                Button { text: "LOAD"; clicked => { root.load-preset(); } }
                Text { text: presets-info; color: Palette.textMuted; font-size: 10px; vertical-alignment: center; }
            }
        }

        // Main rack: routing, pitch correction and effect modules.
        HorizontalBox {
            width: 100%; spacing: 12px;
            Rectangle {
                background: Palette.surface; border-width: 1px; border-color: Palette.outline; border-radius: 8px;
                VerticalBox {
                    padding: 14px; spacing: 9px;
                    Text { text: "1. ĐẦU VÀO & KHỬ ỒN STUDIO"; color: Palette.accent; font-size: 13px; font-weight: 700; }
                    Text { text: "MICRO  ·  " + input-device-status; color: Palette.textMuted; font-size: 10px; }
                    Button { text: "↻ TẢI LẠI THIẾT BỊ"; clicked => { root.refresh-devices(); } }
                    Text { text: "ĐỘ NHẠY MICRO  " + input-gain-text; color: Palette.text; font-size: 11px; }
                    Slider { minimum: -60; maximum: 24; value: input-gain-db; }
                    Text { text: "THIẾT BỊ ĐẦU RA"; color: Palette.textMuted; font-size: 10px; }
                    ComboBox { model: output-device-names; current-index: selected-output; }
                    Text { text: output-device-status; color: Palette.textMuted; font-size: 10px; }
                    Rectangle { width: 100%; height: 1px; background: Palette.outline; }
                    Text { text: "CÂN BẰNG  " + pan-text; color: Palette.text; font-size: 12px; }
                    Slider { minimum: -1; maximum: 1; value: pan; }
                    Button { text: muted ? "MUTE: ON" : "MUTE: OFF"; clicked => { root.mute-toggle(); } }
                }
            }
            Rectangle {
                background: Palette.surface; border-width: 1px; border-color: Palette.outline; border-radius: 8px;
                VerticalBox {
                    padding: 14px; spacing: 10px;
                    Text { text: "2. AUTO-TUNE UỐN GIỌNG"; color: Palette.cyan; font-size: 13px; font-weight: 700; }
                    EffectSlot {
                        name: "AUTO TUNE"; present: pitch-present; enabled: pitch-enabled; wet-text: pitch-wet-text;
                        param0-text: pitch-p0t; param1-text: pitch-p1t; param2-text: pitch-p2t; param3-text: pitch-p3t;
                        param4-text: pitch-p4t; param5-text: pitch-p5t;
                        toggle => { pitch-toggle(); }
                    }
                    Text { text: pitch-available ? "DETECTED  " + pitch-detected-text : "WAITING FOR PITCH INPUT"; color: Palette.text; font-size: 17px; font-weight: 700; }
                    Text { text: "TARGET     " + pitch-target-text; color: Palette.textMuted; font-size: 12px; }
                    Text { text: "CONFIDENCE " + pitch-confidence-text; color: Palette.textMuted; font-size: 12px; }
                    Text { text: "SHIFT      " + pitch-shift-text; color: Palette.textMuted; font-size: 12px; }
                    Rectangle { width: 100%; height: 1px; background: Palette.outline; }
                    Text { text: "Live pitch data appears when Pitch Correction is active."; color: Palette.textMuted; font-size: 10px; }
                }
            }
            Rectangle {
                background: Palette.surface; border-width: 1px; border-color: Palette.outline; border-radius: 8px;
                VerticalBox {
                    padding: 14px; spacing: 8px;
                    HorizontalBox {
                        Text { text: "3. HIỆU ỨNG GIỌNG HÁT"; color: Palette.text; font-size: 13px; font-weight: 700; }
                        Text { text: chain-summary; color: Palette.textMuted; font-size: 10px; }
                    }
                    HorizontalBox { spacing: 7px;
                        EffectSlot { name: "Noise Gate"; present: ng-present; enabled: ng-enabled; wet-text: ng-wet-text; param0-text: ng-p0t; param1-text: ng-p1t; param2-text: ng-p2t; param3-text: ng-p3t; param4-text: ng-p4t; toggle => { ng-toggle(); } }
                        EffectSlot { name: "Equalizer"; present: eq-present; enabled: eq-enabled; wet-text: eq-wet-text; param0-text: eq-p0t; param1-text: eq-p1t; param2-text: eq-p2t; param3-text: eq-p3t; param4-text: eq-p4t; param5-text: eq-p5t; toggle => { eq-toggle(); } }
                        EffectSlot { name: "Compressor"; present: comp-present; enabled: comp-enabled; wet-text: comp-wet-text; param0-text: comp-p0t; param1-text: comp-p1t; param2-text: comp-p2t; param3-text: comp-p3t; param4-text: comp-p4t; param5-text: comp-p5t; toggle => { comp-toggle(); } }
                    }
                    HorizontalBox { spacing: 7px;
                        EffectSlot { name: "De-Esser"; present: deesser-present; enabled: deesser-enabled; wet-text: deesser-wet-text; param0-text: deesser-p0t; param1-text: deesser-p1t; param2-text: deesser-p2t; param3-text: deesser-p3t; param4-text: deesser-p4t; toggle => { deesser-toggle(); } }
                        EffectSlot { name: "Saturation"; present: sat-present; enabled: sat-enabled; wet-text: sat-wet-text; param0-text: sat-p0t; param1-text: sat-p1t; param2-text: sat-p2t; toggle => { sat-toggle(); } }
                        EffectSlot { name: "Limiter"; present: lim-present; enabled: lim-enabled; wet-text: lim-wet-text; param0-text: lim-p0t; param1-text: lim-p1t; param2-text: lim-p2t; toggle => { lim-toggle(); } }
                    }
                    HorizontalBox { spacing: 7px;
                        EffectSlot { name: "Reverb"; present: rev-present; enabled: rev-enabled; wet-text: rev-wet-text; param0-text: rev-p0t; param1-text: rev-p1t; param2-text: rev-p2t; param3-text: rev-p3t; param4-text: rev-p4t; param5-text: rev-p5t; toggle => { rev-toggle(); } }
                        EffectSlot { name: "Delay"; present: delay-present; enabled: delay-enabled; wet-text: delay-wet-text; param0-text: delay-p0t; param1-text: delay-p1t; param2-text: delay-p2t; param3-text: delay-p3t; toggle => { delay-toggle(); } }
                        Rectangle { background: #111315; border-width: 1px; border-color: Palette.outline; border-radius: 8px; Text { text: "SIGNAL\nCHAIN"; color: Palette.textMuted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                }
            }
        }
      }
    }

    ScrollView {
      visible: false;
      VerticalBox {
        spacing: 18px;
        padding: 22px;
        Text {
            text: "PITCHFORGE — VOICE STUDIO";
            color: Palette.text;
            font-size: 24px;
            font-weight: 700;
        }
        HorizontalBox {
            spacing: 12px;
            StatusBadge {
                status-text: engine-warning != "" ? "Engine: " + engine-warning : "Engine: waiting";
                badge-color: engine-error != "" ? Palette.destructive : Palette.accent;
            }
            Button {
                text: start-button-text;
                enabled: engine-warning == "";
                clicked => { root.start-engine(); }
            }
        }
        HorizontalBox {
            spacing: 16px;
            DevicesPanel {
                input-names: input-device-names;
                output-names: output-device-names;
                selected-input: selected-input;
                selected-output: selected-output;
                input-status: input-device-status;
                output-status: output-device-status;
            }
            MixerPanel {
                in-peak-l: in-peak-l;
                in-peak-r: in-peak-r;
                in-rms-l: in-rms-l;
                in-rms-r: in-rms-r;
                out-peak-l: out-peak-l;
                out-peak-r: out-peak-r;
                out-rms-l: out-rms-l;
                out-rms-r: out-rms-r;
                clipping: clipping;
                latency-text: latency-text;
                status-text: engine-warning;
            }
            VerticalBox {
                spacing: 12px;
                // ---- Mixer faders + pan + mute ----
                VerticalBox {
                    spacing: 8px;
                    Text {
                        text: "INPUT (dB)";
                        color: Palette.textMuted;
                        font-size: 14px;
                    }
                    Slider {
                        minimum: -60;
                        maximum: 24;
                        value: input-gain-db;
                    }
                    Text {
                        text: input-gain-text;
                        color: Palette.text;
                        font-size: 14px;
                    }
                    Text {
                        text: "OUTPUT (dB)";
                        color: Palette.textMuted;
                        font-size: 14px;
                    }
                    Slider {
                        minimum: -60;
                        maximum: 12;
                        value: output-gain-db;
                    }
                    Text {
                        text: output-gain-text;
                        color: Palette.text;
                        font-size: 14px;
                    }
                    HorizontalBox {
                        spacing: 12px;
                        Text {
                            text: "PAN (-1 .. +1)";
                            color: Palette.textMuted;
                            font-size: 14px;
                        }
                        Slider {
                            minimum: -1;
                            maximum: 1;
                            value: pan;
                        }
                        Text {
                            text: pan-text;
                            color: Palette.text;
                            font-size: 14px;
                        }
                        Button {
                            text: muted ? "Mute" : "Unmute";
                            clicked => { root.mute-toggle(); }
                        }
                    }
                }

                // ---- Effects chain ----
                Text {
                    text: "EFFECTS CHAIN";
                    color: Palette.textMuted;
                    font-size: 15px;
                }
                Text {
                    text: chain-summary;
                    color: Palette.textMuted;
                    font-size: 15px;
                }
                VerticalBox {
                    spacing: 8px;
                    EffectSlot {
                        name: "Noise Gate";
                        present: ng-present;
                        enabled: ng-enabled;
                        wet-text: ng-wet-text;
                        param0-text: ng-p0t;
                        param1-text: ng-p1t;
                        param2-text: ng-p2t;
                        param3-text: ng-p3t;
                        param4-text: ng-p4t;
                        toggle => { ng-toggle(); }
                    }
                    EffectSlot {
                        name: "Equalizer";
                        present: eq-present;
                        enabled: eq-enabled;
                        wet-text: eq-wet-text;
                        param0-text: eq-p0t;
                        param1-text: eq-p1t;
                        param2-text: eq-p2t;
                        param3-text: eq-p3t;
                        param4-text: eq-p4t;
                        param5-text: eq-p5t;
                        toggle => { eq-toggle(); }
                    }
                    EffectSlot {
                        name: "De-Esser";
                        present: deesser-present;
                        enabled: deesser-enabled;
                        wet-text: deesser-wet-text;
                        param0-text: deesser-p0t;
                        param1-text: deesser-p1t;
                        param2-text: deesser-p2t;
                        param3-text: deesser-p3t;
                        param4-text: deesser-p4t;
                        toggle => { deesser-toggle(); }
                    }
                    EffectSlot {
                        name: "Compressor";
                        present: comp-present;
                        enabled: comp-enabled;
                        wet-text: comp-wet-text;
                        param0-text: comp-p0t;
                        param1-text: comp-p1t;
                        param2-text: comp-p2t;
                        param3-text: comp-p3t;
                        param4-text: comp-p4t;
                        param5-text: comp-p5t;
                        toggle => { comp-toggle(); }
                    }
                    EffectSlot {
                        name: "Pitch Correction";
                        present: pitch-present;
                        enabled: pitch-enabled;
                        wet-text: pitch-wet-text;
                        param0-text: pitch-p0t;
                        param1-text: pitch-p1t;
                        param2-text: pitch-p2t;
                        param3-text: pitch-p3t;
                        param4-text: pitch-p4t;
                        param5-text: pitch-p5t;
                        toggle => { pitch-toggle(); }
                    }
                    EffectSlot {
                        name: "Saturation";
                        present: sat-present;
                        enabled: sat-enabled;
                        wet-text: sat-wet-text;
                        param0-text: sat-p0t;
                        param1-text: sat-p1t;
                        param2-text: sat-p2t;
                        toggle => { sat-toggle(); }
                    }
                    EffectSlot {
                        name: "Reverb";
                        present: rev-present;
                        enabled: rev-enabled;
                        wet-text: rev-wet-text;
                        param0-text: rev-p0t;
                        param1-text: rev-p1t;
                        param2-text: rev-p2t;
                        param3-text: rev-p3t;
                        param4-text: rev-p4t;
                        param5-text: rev-p5t;
                        toggle => { rev-toggle(); }
                    }
                    EffectSlot {
                        name: "Delay";
                        present: delay-present;
                        enabled: delay-enabled;
                        wet-text: delay-wet-text;
                        param0-text: delay-p0t;
                        param1-text: delay-p1t;
                        param2-text: delay-p2t;
                        param3-text: delay-p3t;
                        toggle => { delay-toggle(); }
                    }
                    EffectSlot {
                        name: "Limiter";
                        present: lim-present;
                        enabled: lim-enabled;
                        wet-text: lim-wet-text;
                        param0-text: lim-p0t;
                        param1-text: lim-p1t;
                        param2-text: lim-p2t;
                        toggle => { lim-toggle(); }
                    }
                }
                Text {
                    text: "(no effects on the chain yet)";
                    color: Palette.textMuted;
                    font-size: 15px;
                }
            }

            VerticalBox {
                spacing: 12px;
                Text {
                    text: "PITCH";
                    color: Palette.textMuted;
                    font-size: 15px;
                }
                if (!pitch-available) : Text {
                    text: "Not detected yet (add Pitch Correction to the chain)";
                    color: Palette.textMuted;
                    font-size: 15px;
                }
                if (pitch-available) : VerticalBox {
                    Text {
                        text: pitch-detected-text;
                        color: Palette.text;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Target: " + pitch-target-text;
                        color: Palette.textMuted;
                        font-size: 15px;
                    }
                    Text {
                        text: "Confidence: " + pitch-confidence-text;
                        color: Palette.textMuted;
                        font-size: 15px;
                    }
                    Text {
                        text: "Shift: " + pitch-shift-text;
                        color: Palette.textMuted;
                        font-size: 15px;
                    }
                }
            }
        }

        Text {
            text: "PRESETS";
            color: Palette.textMuted;
            font-size: 15px;
        }
        HorizontalBox {
            spacing: 8px;
            ComboBox {
                model: preset-names;
                current-index: selected-preset;
            }
            LineEdit {
                text: preset-name;
            }
            Button {
                text: "Save";
                clicked => { root.save-preset(); }
            }
            Button {
                text: "Load";
                clicked => { root.load-preset(); }
            }
        }
        Text {
            text: presets-info;
            color: Palette.textMuted;
            font-size: 15px;
        }
      }
    }
}
