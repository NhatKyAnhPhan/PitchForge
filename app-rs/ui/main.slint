    in-out property <bool> comp-present;
    in-out property <bool> comp-enabled;
    in-out property <float> comp-wet;
    in-out property <string> comp-wet-text;
    in-out property <bool> comp-p0;
    in-out property <float> comp-p0v;
    in-out property <string> comp-p0t;
