// AURALIS STUDIO — PitchForge product UI (Rust/Slint)
// Palette: design-system/auralis-studio/MASTER.md

import {
    VerticalBox,
    HorizontalBox,
    Slider,
    ComboBox,
    Button,
    LineEdit,
} from "std-widgets.slint";

global Palette {
    in property <color> background: #0F172A;
    in property <color> surface: #192134;
    in property <color> outline: #FFFFFF18;
    in property <color> text: #FFFFFF;
    in property <color> textMuted: #94A3B8;
    in property <color> primary: #7C3AED;
    in property <color> accent: #22C55E;
    in property <color> destructive: #DC2626;
    in property <color> onAccent: #0F172A;
}

// ---------------------------------------------------------------------------
// Styled primitives
// ---------------------------------------------------------------------------

component StatusBadge {
    in property <string> status-text;
    in property <color> badge-color;
    Rectangle {
        background: Palette.surface;
        border-width: 1px;
        border-color: badge-color;
        border-radius: 4px;
        height: 20px;
        Text {
            text: status-text;
            color: badge-color;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}

component MeterBar {
    // A vertical meter bar with a peak fill and an RMS fill.
    in property <float> peak;
    in property <float> rms;
    property <float> fill: max(0.0, min(1.0, peak));

    Rectangle {
        width: 40px;
        height: 120px;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.outline;
        border-radius: 4px;
        Rectangle {
            width: 100%;
            height: 120px * fill;
            background: peak > 0.98 ? Palette.destructive : Palette.accent;
            border-radius: 3px;
        }
        Rectangle {
            width: 18px;
            height: 90px * max(0.0, min(1.0, rms));
            background: Palette.primary;
            border-radius: 2px;
            y: 15px;
        }
    }
}

// ---------------------------------------------------------------------------
// Devices panel
// ---------------------------------------------------------------------------

component DevicesPanel {
    in property <[string]> input-names;
    in property <[string]> output-names;
    in-out property <int> selected-input;
    in-out property <int> selected-output;
    in property <string> input-status;
    in property <string> output-status;

    VerticalBox {
        Text {
            text: "DEVICES";
            color: Palette.textMuted;
            font-size: 13px;
        }
        Text {
            text: "INPUT";
            color: Palette.textMuted;
            font-size: 11px;
        }
        ComboBox {
            model: input-names;
            current-index: selected-input;
        }
        Text {
            text: input-status;
            color: Palette.textMuted;
            font-size: 11px;
        }
        Text {
            text: "OUTPUT";
            color: Palette.textMuted;
            font-size: 11px;
        }
        ComboBox {
            model: output-names;
            current-index: selected-output;
        }
        Text {
            text: output-status;
            color: Palette.textMuted;
            font-size: 11px;
        }
    }
}

// ---------------------------------------------------------------------------
// Mixer panel
// ---------------------------------------------------------------------------

component MixerPanel {
    in property <float> in-peak-l;
    in property <float> in-peak-r;
    in property <float> in-rms-l;
    in property <float> in-rms-r;
    in property <float> out-peak-l;
    in property <float> out-peak-r;
    in property <float> out-rms-l;
    in property <float> out-rms-r;
    in property <bool> clipping;
    in property <string> latency-text;
    in property <string> status-text;

    VerticalBox {
        Text {
            text: "MIXER";
            color: Palette.textMuted;
            font-size: 13px;
        }
        HorizontalBox {
            spacing: 16px;
            VerticalBox {
                Text {
                    text: "INPUT";
                    color: Palette.textMuted;
                    font-size: 11px;
                }
                MeterBar {
                    peak: in-peak-l;
                    rms: in-rms-l;
                }
                MeterBar {
                    peak: in-peak-r;
                    rms: in-rms-r;
                }
            }
            VerticalBox {
                Text {
                    text: "OUTPUT";
                    color: Palette.textMuted;
                    font-size: 11px;
                }
                MeterBar {
                    peak: out-peak-l;
                    rms: out-rms-l;
                }
                MeterBar {
                    peak: out-peak-r;
                    rms: out-rms-r;
                }
            }
        }
        Text {
            text: latency-text;
            color: Palette.textMuted;
            font-size: 11px;
        }
        Text {
            text: status-text;
            color: Palette.textMuted;
            font-size: 11px;
        }
    }
}

// ---------------------------------------------------------------------------
// Effect slot card
// ---------------------------------------------------------------------------

component EffectSlot {
    // Display-only card for one effect type in the chain.
    in property <string> name;
    in property <bool> present;
    in property <bool> enabled;
    in property <string> wet-text;
    in property <string> param0-text;
    in property <string> param1-text;
    in property <string> param2-text;
    in property <string> param3-text;
    in property <string> param4-text;
    in property <string> param5-text;
    callback toggle;

    Rectangle {
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.outline;
        border-radius: 8px;
        VerticalBox {
            spacing: 6px;
            HorizontalBox {
                Text {
                    text: name;
                    color: Palette.text;
                    font-weight: 700;
                }
                if (!present) : Text {
                    text: "(off)";
                    color: Palette.textMuted;
                }
            }
            if (present) : Button {
                text: enabled ? "On" : "Off";
                clicked => { root.toggle(); }
            }
            Text {
                text: "Wet: " + wet-text;
                color: Palette.textMuted;
                font-size: 11px;
            }
            if (param0-text != "") : Text {
                text: param0-text;
                color: Palette.textMuted;
                font-size: 11px;
            }
            if (param1-text != "") : Text {
                text: param1-text;
                color: Palette.textMuted;
                font-size: 11px;
            }
            if (param2-text != "") : Text {
                text: param2-text;
                color: Palette.textMuted;
                font-size: 11px;
            }
            if (param3-text != "") : Text {
                text: param3-text;
                color: Palette.textMuted;
                font-size: 11px;
            }
            if (param4-text != "") : Text {
                text: param4-text;
                color: Palette.textMuted;
                font-size: 11px;
            }
            if (param5-text != "") : Text {
                text: param5-text;
                color: Palette.textMuted;
                font-size: 11px;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// App
// ---------------------------------------------------------------------------

export component App inherits Window {
    title: "AURALIS STUDIO — PITCHFORGE (Rust UI)";
    width: 1260px;
    height: 980px;

    // --- devices ---
    in-out property <[string]> input-device-names;
    in-out property <[string]> output-device-names;
    in-out property <int> selected-input;
    in-out property <int> selected-output;
    in-out property <string> input-device-status;
    in-out property <string> output-device-status;

    // --- engine ---
    in-out property <string> engine-warning;
    in-out property <bool> engine-started;
    in-out property <string> engine-error;
    in-out property <string> start-button-text;

    // --- mixer ---
    in-out property <float> input-gain-db;
