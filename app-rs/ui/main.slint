    in-out property <float> deesser-wet;
    in-out property <string> deesser-wet-text;
    in-out property <bool> deesser-p0;
    in-out property <float> deesser-p0v;
    in-out property <string> deesser-p0t;
    in-out property <bool> deesser-p1;
